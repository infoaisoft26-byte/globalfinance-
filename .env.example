DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/global_finance
AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_URL=http://localhost:3000

# Real money movement is OFF by default.
PAYMENTS_ENABLED=false
PAYOUTS_ENABLED=false

# Private S3-compatible storage for KYC documents (AWS S3, Cloudflare R2, MinIO, etc.)
KYC_STORAGE_ENDPOINT=https://YOUR-S3-ENDPOINT
KYC_STORAGE_REGION=auto
KYC_STORAGE_ACCESS_KEY_ID=replace-me
KYC_STORAGE_SECRET_ACCESS_KEY=replace-me
KYC_STORAGE_BUCKET=global-finance-private-kyc
KYC_STORAGE_FORCE_PATH_STYLE=false

# One-time bootstrap only. Do not keep these values in production after creating the admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Global Finance Admin

# BNB Smart Chain USDT BEP20 deposits
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
USDT_BEP20_CONTRACT_ADDRESS=0x55d398326f99059ff775485246999027b3197955
USDT_DEPOSIT_WALLET_ADDRESS=replace-with-your-bsc-deposit-wallet
